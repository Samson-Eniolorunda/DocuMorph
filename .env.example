# Names only. Put real values in the hosting dashboard, never in the repository.

# Required. The public address of the site, for canonical links, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=
# Optional. Each link is hidden when its variable is unset.
NEXT_PUBLIC_PORTFOLIO_URL=
NEXT_PUBLIC_BUYMEACOFFEE_URL=

# Word and Excel to PDF: the self-hosted Gotenberg service (see infra/gotenberg/README.md).
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# PDF to Word and PDF to Excel: Adobe PDF Services (free tier, 500 transactions a month).
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
# Optional caps for the whole site. Defaults: 450 a month, 25 a day.
ADOBE_MONTHLY_CAP=
ADOBE_DAILY_CAP=

# Feedback e-mail: sent through Resend to this one address (the owner's own).
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=

# Limits. Defaults: 10 conversions per visitor per day, no site-wide cap.
CONVERT_DAILY_PER_VISITOR=
CONVERT_DAILY_SITE_CAP=
# Shared counts (a free Upstash Redis database). Required for the Adobe tools, because their cap must be exact.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
